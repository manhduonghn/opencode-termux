<?xml version="1.0" encoding="utf-8"?>
<!-- Branded progress dialog shown while the Termux bootstrap, the helper
     libraries and the OpenCode runtime are being installed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_card"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/startup_progress_title"
            android:src="@drawable/ic_opencode_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/startup_progress_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/startup_progress_title"
                android:textColor="@color/app_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startup_progress_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/startup_progress_subtitle"
                android:textColor="@color/app_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/startup_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_app_pill"
            android:minWidth="46dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="…"
            android:textColor="@color/app_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/startup_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/app_accent"
        android:max="100"
        android:progressDrawable="@drawable/bg_app_progress" />

    <TextView
        android:id="@+id/startup_progress_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/app_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/startup_progress_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/app_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/startup_progress_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_app_log"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:maxLines="6"
        android:padding="12dp"
        android:text="@string/startup_progress_log_empty"
        android:textColor="@color/app_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/startup_progress_hint"
        android:textColor="@color/app_muted"
        android:textSize="12sp" />

</LinearLayout>
