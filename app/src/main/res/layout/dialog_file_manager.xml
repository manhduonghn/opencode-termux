<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/managed_file_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!-- App-style header, the manager is a full screen app screen instead of a dialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/managed_file_locations"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_locations"
                android:padding="10dp"
                android:src="@drawable/ic_menu"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/managed_file_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/opencode_files_dialog_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/managed_file_view_mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_view_mode"
                android:padding="10dp"
                android:src="@drawable/ic_grid"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_more"
                android:padding="10dp"
                android:src="@drawable/ic_more"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Path / navigation toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/managed_file_up"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_up"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_home"
                android:padding="9dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/managed_file_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="middle"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Breadcrumbs for quick navigation between path components -->
        <HorizontalScrollView
            android:id="@+id/managed_file_breadcrumb_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/managed_file_breadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <!-- Selection toolbar, only visible in selection mode -->
        <LinearLayout
            android:id="@+id/managed_file_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/managed_file_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/managed_file_selection_all"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_select_all"
                android:padding="9dp"
                android:src="@drawable/ic_select_all"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_selection_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_share"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_selection_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_delete"
                android:padding="10dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_selection_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_more"
                android:padding="10dp"
                android:src="@drawable/ic_more"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/managed_file_selection_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Summary / progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/managed_file_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:paddingStart="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/managed_file_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/managed_file_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/opencode_files_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/managed_file_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="vertical" />

            <GridView
                android:id="@+id/managed_file_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="4dp"
                android:numColumns="3"
                android:padding="4dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/managed_file_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/opencode_files_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/opencode_files_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/managed_file_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/opencode_files_new"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary" />

    <View
        android:id="@+id/managed_file_drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/managed_file_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:attr/colorBackground"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="@string/opencode_files_locations_title"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/managed_file_drawer_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
