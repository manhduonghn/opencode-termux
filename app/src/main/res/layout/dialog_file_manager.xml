<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Path / navigation toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/managed_file_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_up"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_home"
            android:padding="9dp"
            android:src="@drawable/ic_home"
            app:tint="@color/github_muted" />

        <TextView
            android:id="@+id/managed_file_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="middle"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:textColor="@color/github_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/managed_file_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_more"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/github_muted" />
    </LinearLayout>

    <!-- Search field, only visible while searching -->
    <LinearLayout
        android:id="@+id/managed_file_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/managed_file_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/opencode_files_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/managed_file_search_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_search_close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/github_muted" />
    </LinearLayout>

    <!-- Selection toolbar, only visible in selection mode -->
    <LinearLayout
        android:id="@+id/managed_file_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/managed_file_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/github_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/managed_file_selection_all"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_select_all"
            android:padding="9dp"
            android:src="@drawable/ic_select_all"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_selection_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_share"
            android:padding="10dp"
            android:src="@drawable/ic_share"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_selection_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_delete"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_selection_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_more"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/github_muted" />

        <ImageButton
            android:id="@+id/managed_file_selection_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/github_muted" />
    </LinearLayout>

    <!-- Summary / progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/managed_file_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:paddingStart="4dp"
            android:textColor="@color/github_muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/managed_file_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/managed_file_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/opencode_files_refresh"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/github_muted" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/managed_file_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/managed_file_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/opencode_files_empty"
            android:textColor="@color/github_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/opencode_files_hint"
        android:textColor="@color/github_muted"
        android:textSize="11sp" />
</LinearLayout>
